// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  name       String       @default("Unknown") @db.VarChar(50)
  phone      String?      @unique @db.VarChar(20)
  password   String
  birthdate  DateTime
  id_rol     Int
  //relaciones
  rol        Rol          @relation(fields: [id_rol], references: [id]) // relacion donde actua la forania
  sales      Sale[]
  Investment Investment[]
}

model Rol {
  id    Int    @id @default(autoincrement())
  name  String
  //relaciones
  users User[] // "Un rol puede tener varios usuarios asociados." 
}

model Product {
  id               Int                @id @default(autoincrement())
  description      String             @default("No description") @db.VarChar(100) // descripción con límite razonable
  price_sale       Decimal            @db.Decimal(10, 2) // precio con 2 decimales, formato estándar
  cost_price       Decimal            @db.Decimal(10, 2)
  stock            Int                @default(0) // stock con valor por defecto
  id_category      Int
  category         Category           @relation(fields: [id_category], references: [id]) // relacion donde actua la forania
  saleDetails      SaleDetail[]
  provider         provider?          @relation(fields: [providerId], references: [id])
  providerId       Int?
  InvestmentDetail InvestmentDetail[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(50)
  //relaciones
  products Product[] // "Una categoria puede tener varios productos asociados."
}

model Sale {
  id             Int          @id @default(autoincrement())
  date           DateTime     @default(now()) // fecha de la venta
  total          Decimal      @db.Decimal(10, 2) // total de la venta
  payment_method String       @default("Cash") @db.VarChar(20) // metodo de pago
  description    String       @default("No description") @db.VarChar(100) // descripción con límite razonable
  id_user        Int
  user           User         @relation(fields: [id_user], references: [id]) // relacion donde actua la forania
  saleDetails    SaleDetail[] // "Una venta puede tener varios detalles de venta asociados."
}

model SaleDetail {
  id         Int     @id @default(autoincrement())
  amount     Int     @default(1) // cantidad de productos vendidos
  subtotal   Decimal @db.Decimal(10, 2) // precio unitario del producto
  product    Product @relation(fields: [id_product], references: [id]) // relacion donde actua la forania
  id_sale    Int
  sale       Sale    @relation(fields: [id_sale], references: [id]) // relacion donde actua la forania
  id_product Int
}

model provider {
  id         Int          @id @default(autoincrement())
  name       String       @unique @db.VarChar(50) // nombre del proveedor
  number     String?      @unique @db.VarChar(20) // telefono del proveedor
  products   Product[] // "Un proveedor puede tener varios productos asociados."
  Investment Investment[] // "Un proveedor puede tener varias inversiones asociadas."
}

model Investment {
  id               Int                @id @default(autoincrement())
  date             DateTime           @default(now()) // fecha de la inversion
  total            Decimal            @db.Decimal(10, 2) // monto de la inversion
  id_provider      Int
  provider         provider           @relation(fields: [id_provider], references: [id]) // relacion donde actua la forania
  InvestmentDetail InvestmentDetail[]
  User             User?              @relation(fields: [userId], references: [id])
  userId           Int?
}

model InvestmentDetail {
  id            Int        @id @default(autoincrement())
  amount        Int        @default(1) // cantidad de productos invertidos
  subtotal      Decimal    @db.Decimal(10, 2) // precio unitario del producto
  id_product    Int
  product       Product    @relation(fields: [id_product], references: [id]) // relacion donde actua la forania
  id_investment Int
  investment    Investment @relation(fields: [id_investment], references: [id]) // relacion donde actua la forania
}
